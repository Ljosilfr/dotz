#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    show_song_table_header: true,
    draw_borders: true,
    format_tag_separator: " | ",
    browser_column_widths: [0, 99, 0],
    background_color: None,
    text_color: None,
    header_background_color: None,
    modal_background_color: None,
    modal_backdrop: false,
    preview_label_style: (fg: "yellow"),
    preview_metadata_group_style: (fg: "yellow", modifiers: "Bold"),
    tab_bar: (
        enabled: true,
        active_style: (fg: "black", bg: "blue", modifiers: "Bold"),
        inactive_style: (),
    ),
    highlighted_item_style: (fg: "blue", modifiers: "Bold"),
    current_item_style: (fg: "black", bg: "blue", modifiers: "Bold"),
    borders_style: (fg: "blue"),
    highlight_border_style: (fg: "blue"),
    symbols: (
        song: "󰽴",
        dir: "󰽯",
        playlist: "󰽻",
        marker: "󰽮",
        ellipsis: "...",
        song_style: None,
        dir_style: None,
        playlist_style: None,
    ),
    level_styles: (
        info: (fg: "blue", bg: "black"),
        warn: (fg: "yellow", bg: "black"),
        error: (fg: "red", bg: "black"),
        debug: (fg: "light_green", bg: "black"),
        trace: (fg: "magenta", bg: "black"),
    ),
    progress_bar: (
        symbols: ["[", "=", "=", "=", "]"],
        track_style: (fg: "#606080"),
        elapsed_style: (fg: "#BACCFF"),
        thumb_style: (fg: "#BACCFF"),
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (),
        ends_style: (),
        thumb_style: (fg: "blue"),
    ),
    cava: (
        bar_width: 1,
    ),
    song_table_format: [
        (
            prop: (kind: Property(Artist),
                default: (kind: Text("Unknown"))
            ),
            width: "20%",
        ),
        (
            prop: (kind: Property(Title),
                default: (kind: Text("Unknown"))
            ),
            width: "35%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "white"),
                default: (kind: Text("Unknown Album"), style: (fg: "white"))
            ),
            width: "30%",
        ),
        (
            prop: (kind: Property(Duration),
                default: (kind: Text("-"))
            ),
            width: "15%",
            alignment: Right,
        ),
    ],
    components: {},
    header: (
        rows: [
            (
                left: [
                ],
                center: [
                ],
                right: [
                ]
            ),
        ],
    ),
    browser_song_format: [
        (
            kind: Property(Title),
        ),
    ],

    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "6",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "15",
                            pane: Pane(AlbumArt),
                        ),
                        (
                            size: "100%",
                            pane: Split(
                                direction: Vertical,
                                panes: [
                                    (
                                        size: "1",
                                        pane: Split(
                                            direction: Horizontal,
                                            panes: [
                                                (
                                                    size: "49%",
                                                    pane: Pane(Property(
                                                        content: [
                                                            (kind: Property(Song(Title)), style: (fg: "yellow", modifiers: "Bold"), default: (kind: Text("Unknown"), style: (fg: "yellow", modifiers: "Bold"))),
                                                        ],
                                                        align: Left,
                                                    )),
                                                ),
                                                (
                                                    size: "49%",
                                                    pane: Pane(Property(
                                                        content: [
                                                            (kind: Group([
                                                                (kind: Property(Status(RepeatV2(on_label: "󰑖", off_label: "󰑖", on_style: (fg: "blue"), on_off: (fg: "red"))))),        
                                                                (kind: Text(" • ")),
                                                                (kind: Property(Status(RandomV2(on_label: "", off_label: "", oneshot_label: "", on_style: (fg: "blue"), on_off: (fg: "red"), oneshot_style: (fg: "yellow"))))),
                                                                (kind: Text(" • ")),
                                                                (kind: Property(Status(ConsumeV2(on_label: "󰴀", off_label: "󰴀", oneshot_label: "󰴀", on_style: (fg: "blue"), on_off: (fg: "red"), oneshot_style: (fg: "yellow"))))),
                                                                (kind: Text(" • ")),
                                                            ])),
                                                                (kind: Property(Status(SingleV2(on_label: "󰑘", off_label: "󰑘", oneshot_label: "󰑘", on_style: (fg: "blue"), on_off: (fg: "red"))))),
                                                        ],
                                                        align: Right,
                                                    )),
                                                )
                                            ]
                                        ), 
                                    ),
				                    (
				    	                size: "3",
                                        pane: Pane(Property(
                                            content: [
                                                (kind: Property(Song(Artist)),default: (kind: Text("Unknown Artist"))),
                                            ],
                                        )),
				                    ),
                                    (
                                        size: "2",
                                        pane: Pane(Cava),
                                    ),
                                    (
                                        size: "1",
                                        pane: Pane(ProgressBar),
                                    ),
                                ]
                            )
                        ),
                    ]
                ),
            ),
            (
            size: "3",
            pane: Pane(Tabs),
            ),
            (
            size: "100%",
            pane: Pane(TabContent),
            ),
        ],
    ),
)
