{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/misc/farnese.txt",
        "color": {
            "1": "bright_white",
        },
        "padding": {
        	"top": 1,
        	"left": 4
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        {
            "type": "os",
            "key": " ",
            "keyColor": "cyan",
            "format": "{2}"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "cyan",
            "format": "{1}"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "cyan",
            "format": "{1}"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "cyan",
            "format": "{1}"
        },
        {
            "type": "memory",
            "key": "󰘚 ",
            "keyColor": "cyan",
            "format": "{2}"
        },
        {
            "type": "gpu",
            "key": "󰍛 ",
            "keyColor": "cyan",
            "format": "{2}"
        },
        {
            "type": "cpu",
            "key": "󰻠 ",
            "keyColor": "cyan",
            "format": "{1}"
        },

        "break",
        {
            "type": "colors",
            "symbol": "blocks"
        }
    ]
}
