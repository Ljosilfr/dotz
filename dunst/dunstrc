[global]
    scale = 0
    monitor = 0
    follow = none
    width = (0, 400)
    height = (0, 300)
    offset = (10, 50)
    origin = bottom-center
    notification_limit = 5
    progress_bar = false
    icon_corner_radius = 0
    icon_corners = all
    indicate_hidden = yes
    transparency = 0
    separator_height = 0
    padding = 12
    horizontal_padding = 16
    text_icon_padding = 0
    frame_width = 1
    gap_size = 10
    separator_color = none
    sort = yes
    font = JetBrainsMonoNL Nerd Font Propo Bold 12
    line_height = 2
    markup = full
    format = "%s\n%b"
    alignment = center
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = false
    hide_duplicate_count = false
    show_indicators = false
    enable_recursive_icon_lookup = false
    icon_path = /usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/
    icon_theme = Colloid-Grey-Dark
    icon_position = left
    min_icon_size = 24
    max_icon_size = 64
    sticky_history = yes
    history_length = 20
    always_run_script = true
    corner_radius = 8
    corners = all
    ignore_dbusclose = false
    layer = overlay
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all
	script = notif_beep
[experimental]
    per_monitor_dpi = false
    pause_on_mouse_over = false
