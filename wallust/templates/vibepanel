:root {
	--color-accent-primary: {{ color6 | saturate(1.0) | lighten(0.58) }};
	--widget-background-color: {{ background }};
	--font-family: "JetBrainsMonoNL Nerd Font Propo";
	--icon-size: 1.38rem;
	--pixmap-icon-size: 2rem;
	--outline-color: {{ color6 | saturate(1.0) | lighten(0.58) }};
	font-weight: 700;
}
.notification-toast {
	margin-bottom: 1.6rem;
}
.taskbar-button.active {
	background-color: #2a2a2a;
	border: 0.1rem solid {{ color6 | saturate(1.0) | lighten(0.58) }};
}
.taskbar-button {
	border: 0.1rem solid transparent;
}
.taskbar-separator {
	margin: 0 0.38rem;
	font-size: 1.2rem;
}
.weather-popover {
	--font-size-md: 0.98rem;
	--font-size-sm: 0.96rem;
	--font-size-xs: 0.94rem;
}
.custom-artix_logo {
	color: {{ color6 | saturate(1.0) | lighten(0.58) }};
}
