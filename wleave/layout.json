{
    "buttons": [
        {
            "label": "shutdown",
            "action": "loginctl poweroff",
            "text": "Shutdown",
            "keybind": "s",
            "icon": "/usr/share/wleave/icons/shutdown.svg"
        },
        {
            "label": "reboot",
            "action": "loginctl reboot",
            "text": "Reboot",
            "keybind": "r",
            "icon": "/usr/share/wleave/icons/reboot.svg"
        },
        {
            "label": "lock",
            "action": "gtklock",
            "text": "Lock",
            "keybind": "l",
            "icon": "/usr/share/wleave/icons/lock.svg"
        }
    ]
}
