// -*- mode: jsonc -*-
{
	"reload_style_on_change": true,
	"ipc": true,
	"spacing": 25,
    "expand-center": true,
    "margin-top": 6,
    "margin-bottom": 0,
	"position": "top",
    "margin-bottom": 0,
	"modules-center": [
		"ext/workspaces",
		"custom/mpd",
		"clock",
		"clock#date",
		"custom/weather",
		"tray",
		"group/quicktoggles"
	],
    "ext/workspaces": {
        "on-click": "activate",
    },
	"custom/mpd": {
		"on-click": "rmpc togglepause",
		"exec": "mpd_stbar",
		"format": "{}",
		"interval": 1,
		"tooltip": false
	},
	"clock": {
		"interval": 60,
		"format": "<span size='13.5pt' rise='-1500'>󱑌</span> {:%H:%m %p}"
	},
	"clock#date": {
		"interval": 60,
		"format": "<span size='13.5pt' rise='-1500'>󰭧</span> {:%d %B %Y}"
	},
	"gamemode": {
		"hide-not-running": false,
		"format": "{glyph}",
		"format-alt": "{glyph}",
		"use-icon": false,
		"tooltip": false,
		"icon-spacing": 0,
		"icon-size": 0,
		"glyph": "<span size='16pt' rise='-1500'>󰊴</span>"
	},
	"custom/weather": {
		"format": "{}",
		"exec": "wttr_in",
		"interval": 1200
	},
    "custom/swayidle" : {
        "exec": "swayidle_indicator -s",
        "on-click": "swayidle_indicator -t",
		"tooltip": false,
        "interval": 2
    },
    "custom/openvpn" : {
        "exec": "openvpn_indicator",
        "on-click": "vpn_toggle",
		"tooltip": false,
        "interval": 2
    },
    "group/quicktoggles": {
        "orientation": "horizontal",
		"drawer": {
			"transition-duration": 500,
			"transition-left-to-right": false
		},
        "modules": [
            "gamemode",
            "custom/swayidle",
            "custom/openvpn"
        ]
    }
    }
}
