// -*- mode: jsonc -*-
{
	"reload_style_on_change": true,
	"ipc": true,
	"spacing": 0,
	"exclusive": true,
	"position": "top",
	"width": 1280,
	"margin-top": 4,

	"modules-left": [
		"custom/wrapper_l",
		"hyprland/workspaces",
		"custom/wrapper_r"
	],
	"modules-center": [
		"mpd",
		"custom/separator",
		"group/hardware-monitor",
		"custom/separator",
		"custom/date",
		"custom/separator",
		"clock"
	],
	"modules-right": [
		"custom/wrapper_l",
		"gamemode",
		"custom/separator2",
		"network",
		"custom/separator2",
		"custom/power",
		"custom/wrapper_r",
	],
	"hyprland/workspaces": {
		"format": "{icon}",
		"persistent-workspaces": {
			"*": 7
		},
		"format-icons": {
			"active": "󰜌",
			"default": ""
		}
	},
	"clock": {
		"format": "<span size='14pt' rise='-1500'>󱑌</span> {:%T}",
		"tooltip": false,
		"interval": 1
	},
	"custom/date": {
		"exec": "formatted_date",
		"tooltip": false,
		"interval": 60
	},
	"group/toolbar": {
		"orientation": "horizontal",
		"modules":[
			"custom/wrapper_l",
			"gamemode",
			"custom/separator2",
			"network",
			"custom/wrapper_r"
		]
	},
	"group/hardware-monitor": {
		"orientation": "horizontal",
		"modules":[
			"cpu",
			"memory"
		]
	},
	"cpu": {
		"interval": 1,
		"format": "<span size='14pt' rise='-1500'>󰻠</span> {usage}%"
	},
	"memory": {
		"interval": 1,
		"format": "<span size='14pt' rise='-1500'>󰘚</span> {percentage}%  <span size='large' rise='-1500'></span> {swapPercentage}%"
	},
	"mpd": {
		"album-artist-len": 12,
		"title-len": 24,
		"format": "<span size='14pt' rise='-1500'>󰽰</span> {title} — {albumArtist} {stateIcon}",
		"on-click": "rmpc togglepause",
		"tooltip": false,
		"format-paused": "<span size='14pt' rise='-1500'>󰽰</span> {title} — {albumArtist} {stateIcon}",
		"format-stopped": "<span size='14pt' rise='-1500'>󰽰󰽼</span> mpd's got to take a break yk",
		"justify": "center",
		"state-icons": {
			"playing": "<span size='14pt' rise='-1500'>󰽱</span>",
			"paused": "<span size='14pt' rise='-1500'>󰽼</span>"
			
		}
	},
	"gamemode": {
		"hide-not-running": false,
		"format": "{glyph}",
		"format-alt": "{glyph}",
		"icon-name": "gaming-app-symbolic",
		"use-icon": false,
		"icon-spacing": 0,
		"icon-size": 0,
		"glyph": "󰺵"
	},
	"custom/timer": {
		"exec-if": "wb_timer_module"
	},
	"network": {
		"format": "󰈀",
		"interval": 1,
		"tooltip-format": "{ifname} - {ipaddr}",
		"on-click": "connection_select"
	},
	"custom/power": {
		"format": "",
		"on-click": "wleave",
		"tooltip-format": "Session Management"
	},
	"custom/separator": {
		"format": "=",
		"tooltip": false
	},
	"custom/separator2": {
		"format": "󰤃",
		"tooltip": false
	},
	"custom/wrapper_l": {
		"format": "",
		"tooltip": false
	},
	"custom/wrapper_r": {
		"format": "",
		"tooltip": false
	}
    }
}
