* {
	bg: #0B1019;
	fg: #C5CCFC;
	accent: #BACCFF;
	null: transparent;
}
configuration {
	modes: [drun];
}
inputbar, entry, prompt, case-indicator, box, overlay, mainbox, cursor, element-icon {
	enabled: false;
}
window {
	border-color: @accent;
	children: [listview];
	orientation: vertical;
	background-color: @bg;
	border: 1px;
    width: 350px;
	border-color: @accent;
	border-radius: 4;
}  
listview {
	children: [element];
	orientation: vertical;
	height: 25px;
	columns: 1;
	border-color: @accent;
	border: 1px 0 0 0;
	background-color: @null;
	padding: 4;
}
element {
	margin: 0;
	padding: 0.20em;
	children: [element-text];
	background-color: @null;
}
element.selected {
	border-radius: 4;
	background-color: @accent;
}
element-text {
	font: "JetBrainsMono Nerd Font Propo Bold 14px";
	vertical-align: 0.5;
	color: @fg;
	background-color: @null;
}
element-text.selected {
	color: black;
}
